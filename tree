// Helper primitive calls that handle array mapping explicitly
function drawSingleBranch(index) {
  let b = branches[index];
  strokeWeight(b[4]);
  line(b[0], b[1], b[2], b[3]);
}

function drawSingleLeaf(index, colorPalette) {
  let l = leaves[index];
  fill(colorPalette[l[4]]);
  ellipse(l[0], l[1], l[2], l[3]);
}

